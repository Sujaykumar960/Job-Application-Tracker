# ==============================================================================
# CareerX - Production Environment Template
# ==============================================================================

# Application Configuration
ENVIRONMENT=production
APP_NAME=CareerX Production Platform
PORT=80

# Security & JWT Tokens (GENERATE A CRYPTOGRAPHICALLY SECURE KEY BEFORE DEPLOYMENT)
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_secure_64_character_hex_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB_NAME=careerx_prod_db

# CORS Allowed Origins (Comma-separated domains)
CORS_ORIGINS=https://careerx.yourdomain.com,http://localhost:80

# Storage
UPLOAD_DIR=/app/uploads
STORAGE_BACKEND=local

# Optional External AI Integration (Groq Llama-3-70B)
GROQ_API_KEY=
