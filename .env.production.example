# ==============================================================================
# CareerX - Production Environment Template (.env.production)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your production Linux server:
#    cp .env.production.example .env
# 2. Fill in all four production credentials below.
# 3. Set file permissions on the Linux host:
#    chmod 600 .env
# 4. NEVER commit '.env' to Git repository!
# ==============================================================================

# Application Runtime Mode
ENVIRONMENT=production
APP_NAME=CareerX Production API
PORT=80

# ------------------------------------------------------------------------------
# 1. JWT_SECRET_KEY (MANDATORY CRYPTOGRAPHIC SECRET)
# ------------------------------------------------------------------------------
# Generate a new 256-bit cryptographically secure key:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_fresh_64_char_hex_token
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 2. MONGODB_URI (MONGODB ATLAS MANAGED CLUSTER)
# ------------------------------------------------------------------------------
# In MongoDB Atlas Console:
# 1. Create a database user (e.g. 'careerx_admin') with 'readWriteAnyDatabase' or 'readWrite@careerx_prod_db'
# 2. Under Network Access, whitelist your Linux Server's public IP address (or 0.0.0.0/0 with strong password)
# 3. Copy the SRV connection string:
MONGODB_URI=mongodb+srv://careerx_user:<YOUR_ATLAS_PASSWORD>@<YOUR_CLUSTER_NAME>.mongodb.net/careerx_prod_db?retryWrites=true&w=majority
MONGODB_DB_NAME=careerx_prod_db

# ------------------------------------------------------------------------------
# 3. REDIS_URL (DISTRIBUTED RATE LIMITING & CACHE)
# ------------------------------------------------------------------------------
# If running the internal Redis container on the Linux Docker stack:
REDIS_URL=redis://redis:6379/0
# If using an external managed Redis (e.g. Upstash, Redis Cloud, ElastiCache):
# REDIS_URL=rediss://default:<REDIS_PASSWORD>@<REDIS_HOST>:<PORT>/0

# ------------------------------------------------------------------------------
# 4. GROQ_API_KEY (SERVER-SIDE AI INFERENCE)
# ------------------------------------------------------------------------------
# Generate in Groq Cloud Console: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_production_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. CORS_ORIGINS & DOMAINS
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins (Your Vercel domain + custom domain):
# Note: FastAPI automatically permits any *.vercel.app domain via regex in backend/app/main.py
CORS_ORIGINS=https://careerx.vercel.app,https://your-custom-domain.com

# ------------------------------------------------------------------------------
# 6. STORAGE & SANDBOX IPC CONFIGURATION
# ------------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
STORAGE_BACKEND=local
CODE_SANDBOX_URL=unix:///sandbox_ipc/sandbox.sock
CODE_SANDBOX_TIMEOUT_SECONDS=5.0

# ==============================================================================
# VERCEL FRONTEND CONFIGURATION (Set in Vercel Project Settings > Environment Variables):
# ==============================================================================
# VITE_API_BASE_URL=https://api.yourdomain.com/api
# (Or if using direct server IP before domain setup: http://<SERVER_IP>/api)
# ==============================================================================
