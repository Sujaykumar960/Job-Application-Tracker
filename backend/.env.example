# ==========================================
# CareerX Backend Environment Variables
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=CareerX Backend API
API_PREFIX=/api

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careerx_db

# Security & JWT Authentication
# IMPORTANT: Generate a cryptographically secure 64-char hex key for production!
# e.g., python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=careerx_super_secret_jwt_key_change_in_production_2026_secure
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Distributed Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Code Execution Sandbox (Optional in development, required in production)
# In Docker compose: unix:///sandbox_ipc/sandbox.sock
# Standalone microservice: http://localhost:2000
CODE_SANDBOX_URL=
